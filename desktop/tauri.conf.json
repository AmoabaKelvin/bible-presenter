{
  "productName": "FlowCast",
  "version": "0.1.0",
  "identifier": "com.kelvinamoaba.flowcast.spike",
  "build": {
    "devUrl": "http://localhost:3217",
    "frontendDist": "http://localhost:3217"
  },
  "app": {
    "windows": [
      {
        "label": "operator",
        "title": "FlowCast",
        "url": "http://localhost:3217",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/FlowCastVoice"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}